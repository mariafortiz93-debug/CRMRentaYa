# CRM Renta Ya - Variables de Entorno
# Copia este archivo como .env.local: cp .env.example .env.local

# =============================================================================
# BASE DE DATOS (obligatoria)
# =============================================================================
# PostgreSQL. En Railway se inyecta sola al conectar el servicio de Postgres
# al del CRM; no hay que escribirla a mano.
# En local, levanta un Postgres y apunta aqui.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/crm

# Opcional: para apuntar a otra base sin tocar la que pone el hosting.
# CRM_DATABASE_URL=postgresql://...

# =============================================================================
# SESIONES
# =============================================================================
# Secreto con el que se firma la cookie de sesion. Al cambiarlo se cierran
# todas las sesiones abiertas y todo el mundo tiene que volver a entrar.
CRM_SESSION_SECRET=una-cadena-larga-y-aleatoria

# =============================================================================
# PRIMER ADMINISTRADOR (opcional)
# =============================================================================
# Solo se usan la primera vez, cuando no existe ningun super administrador.
# Si no se definen se crea "maria" con la clave por defecto.
# CRM_ADMIN_USER=maria
# CRM_ADMIN_PASSWORD=
# CRM_ADMIN_NAME=Maria Ortiz

# =============================================================================
# LLAVE DE REPUESTO (solo si te quedaste por fuera)
# =============================================================================
# Con estas dos puestas, en el siguiente arranque ese usuario queda activo como
# super administrador con esa clave. BORRALAS en cuanto recuperes el acceso:
# mientras esten, la clave se vuelve a imponer en cada despliegue.
# CRM_RECOVERY_USER=respaldo
# CRM_RECOVERY_PASSWORD=
# CRM_RECOVERY_NAME=Acceso de emergencia

# =============================================================================
# OPCIONAL: Email digest diario (registrate gratis en resend.com)
# =============================================================================
# RESEND_API_KEY=re_...
# DIGEST_EMAIL=tu@email.com
# DIGEST_FROM=Renta Ya <onboarding@resend.dev>
