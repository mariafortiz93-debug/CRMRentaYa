# CRM Renta Ya - Variables de Entorno
# Copia este archivo como .env.local: cp .env.example .env.local

# =============================================================================
# ACCESO AL CRM (obligatorio al publicarlo en internet)
# =============================================================================
# Clave compartida que usa el equipo para entrar.
# - En produccion es OBLIGATORIA: si falta, el CRM no deja entrar a nadie.
# - En desarrollo local, si no se define, no se pide clave.
# CRM_PASSWORD=cambia-esta-clave

# Opcional: secreto para firmar la sesion. Si no se define se deriva de
# CRM_PASSWORD. Al cambiarlo se cierran todas las sesiones abiertas.
# CRM_SESSION_SECRET=una-cadena-larga-y-aleatoria

# =============================================================================
# OPCIONAL: Email digest diario (registrate gratis en resend.com)
# =============================================================================
# RESEND_API_KEY=re_...
# DIGEST_EMAIL=tu@email.com
# DIGEST_FROM=Renta Ya <onboarding@resend.dev>
